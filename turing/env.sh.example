# Copy to turing/env.sh and fill in. env.sh is git-ignored: never commit it.
# All values are placeholders until the Turing details in docs/TURING_SETUP.md are confirmed.

export TURING_VERIFIED=""          # set to 1 only after confirmation
export TURING_PYTHON=""            # e.g. /path/to/python3.10
export ECG_VENV=""                 # persistent venv location
export TORCH_SPEC=""               # e.g. "torch==2.5.1 --index-url https://download.pytorch.org/whl/cu121" (match the driver)
export ECG_DATA_ROOT=""            # directory with the dataset subdirectories (mitdb, svdb, incartdb, edb)
export ECG_RUN_ROOT=""             # writable persistent directory for run outputs
export TURING_PARTITION=""         # GPU partition or queue
export TURING_ACCOUNT=""           # project account, if required
